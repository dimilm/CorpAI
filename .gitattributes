# Normalize all text files to LF in the repo AND the working tree. Without this,
# a machine with global core.autocrlf=true rewrites freshly-written LF files to
# CRLF, producing whole-file diffs and re-encoding churn (the repo is LF).
* text=auto eol=lf

# Binaries: never apply EOL conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.db   binary
*.sqlite binary

# Shell scripts and nginx config must stay LF even if the rule above ever changes.
*.sh text eol=lf
docker/backup.sh text eol=lf
docker/nginx.conf text eol=lf
